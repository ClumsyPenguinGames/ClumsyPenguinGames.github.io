<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Task Draw Beta | Clumsy Penguin Games</title>
  <link rel="stylesheet" href="style.css">
  <style>
    .app-container { width: min(100%, 850px); margin: 0 auto; padding: 1.5rem; text-align: left; }
    .app-header { text-align: center; margin-bottom: 1.5rem; }
    .app-header h1 { font-size: clamp(2rem, 7vw, 3rem); }
    .app-header h1 span { color: #FBEEDC; }
    .app-header p { line-height: 1.6; }
    .beta-badge { display: inline-block; background: #FBEEDC; color: #2F2D63; border-radius: 50px; padding: .25rem .7rem; font-size: .75rem; font-weight: 600; letter-spacing: .08em; margin-bottom: .7rem; }
    .app-card { background: #FBEEDC; color: #292744; border-radius: 16px; padding: 1.25rem; margin: 1rem 0; box-shadow: 0 4px 14px rgba(47,45,99,.15); }
    .app-card h2 { font-family: 'Baloo 2', cursive; font-size: 1.45rem; margin-bottom: .5rem; color: #2F2D63; }
    .app-card p { line-height: 1.55; }
    .app-container textarea { display: block; width: 100%; min-height: 130px; resize: vertical; padding: .75rem; border: 1px solid #b9b3c9; border-radius: 10px; font: inherit; color: #292744; background: white; margin: .7rem 0; }
    .app-container button { border: 0; border-radius: 50px; padding: .7rem 1rem; font: inherit; font-weight: 600; cursor: pointer; margin: .35rem .35rem .1rem 0; }
    .app-container button:focus-visible, .app-container textarea:focus-visible, .app-container a:focus-visible { outline: 3px solid #7468c4; outline-offset: 3px; }
    .app-container button:disabled { opacity: .45; cursor: not-allowed; }
    .app-primary { background: #2F2D63; color: #FBEEDC; }
    .app-secondary { background: #e6e1f4; color: #2F2D63; }
    .app-danger { background: #f7d9d7; color: #742b26; }
    .app-status { color: #5f5a70; font-size: .92rem; margin-top: .7rem; }
    .app-choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin: .8rem 0; }
    .app-choice { display: flex; flex-direction: column; justify-content: space-between; min-height: 140px; padding: 1rem; border: 1px solid #d2c9e9; border-radius: 12px; background: white; overflow-wrap: anywhere; }
    .app-choice p { margin-bottom: 1rem; font-size: 1.05rem; }
    .app-empty { color: #6e687d; padding: .5rem 0; }
    .app-container ul { padding-left: 1.4rem; margin-top: .6rem; }
    .app-container li { margin: .35rem 0; overflow-wrap: anywhere; }
    .back-link { display: inline-block; margin-top: 1rem; color: #FBEEDC; font-weight: 600; text-decoration-thickness: 2px; text-underline-offset: 4px; }
    @media (max-width: 540px) { .app-choices { grid-template-columns: 1fr; } .app-container { padding: 1rem; } .app-card { padding: 1rem; } }
  </style>
</head>
<body>
  <main class="app-container">
    <header class="app-header">
      <span class="beta-badge">BETA PROJECT</span>
      <h1>Task Draw</h1>
      <p>Put your tasks in the pool, then let chance choose between two.</p>
      <a class="back-link" href="index.html">← Back to Clumsy Penguin Games</a>
    </header>

    <section class="app-card">
      <h2>1. Your task pool</h2>
      <p>Enter one task per line. Adding tasks keeps your current pool and completed history.</p>
      <textarea id="taskInput" placeholder="Start a load of laundry&#10;Put away dishes&#10;Scoop the litter"></textarea>
      <button class="app-primary" id="addTasksButton">Add tasks to pool</button>
      <button class="app-secondary" id="replaceTasksButton">Replace pool with this list</button>
      <p class="app-status" id="poolStatus" aria-live="polite"></p>
    </section>

    <section class="app-card">
      <h2>2. Choose your next task</h2>
      <div id="choices" class="app-choices"><p class="app-empty">Add at least two tasks, then draw.</p></div>
      <button class="app-primary" id="drawButton">Draw two tasks</button>
      <button class="app-secondary" id="returnButton">Return both to pool</button>
      <p class="app-status" id="drawStatus" aria-live="polite"></p>
    </section>

    <section class="app-card">
      <h2>Completed tasks</h2>
      <p class="app-status" id="completedStatus"></p>
      <ul id="completedList"></ul>
      <button class="app-danger" id="clearCompletedButton">Clear completed history</button>
    </section>
    <p class="app-status">Beta note: tasks are saved in this browser on this device. They aren't synced between devices.</p>
  </main>

  <footer><p>© 2026 Clumsy Penguin Games</p></footer>

<script>
  const STORAGE_KEY = "clumsy-penguin-task-draw-beta-v1";
  let state = { pool: [], completed: [], choices: [] };

  const taskInput = document.getElementById("taskInput");
  const choicesEl = document.getElementById("choices");
  const poolStatus = document.getElementById("poolStatus");
  const drawStatus = document.getElementById("drawStatus");
  const completedStatus = document.getElementById("completedStatus");
  const completedList = document.getElementById("completedList");
  const drawButton = document.getElementById("drawButton");
  const returnButton = document.getElementById("returnButton");

  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
    catch (error) { console.warn("Could not save tasks:", error); }
  }

  function loadState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
      if (saved && Array.isArray(saved.pool) && Array.isArray(saved.completed) && Array.isArray(saved.choices)) state = saved;
    } catch (error) { console.warn("Could not load saved tasks:", error); }
  }

  function getLines() {
    return taskInput.value.split(/\r?\n/).map(task => task.trim()).filter(Boolean);
  }

  function addTasks(replace) {
    const tasks = getLines();
    if (!tasks.length) { alert("Enter at least one task, with one task per line."); return; }
    if (replace) {
      if (!confirm("Replace the available pool? Your completed history will stay.")) return;
      state.pool = tasks;
      state.choices = [];
      drawStatus.textContent = "Pool replaced. Draw two tasks when you're ready.";
    } else {
      state.pool.push(...tasks);
      drawStatus.textContent = "Tasks added. Draw two when you're ready.";
    }
    taskInput.value = "";
    saveState();
    render();
  }

  function drawTwo() {
    if (state.choices.length) {
      drawStatus.textContent = "Choose a task or return both before drawing again.";
      return;
    }
    if (state.pool.length < 2) {
      drawStatus.textContent = state.pool.length === 1 ? "Only one task remains. Add another task to draw two." : "Your pool is empty. Add some tasks first.";
      return;
    }
    const firstIndex = Math.floor(Math.random() * state.pool.length);
    const first = state.pool.splice(firstIndex, 1)[0];
    const secondIndex = Math.floor(Math.random() * state.pool.length);
    const second = state.pool.splice(secondIndex, 1)[0];
    state.choices = [first, second];
    drawStatus.textContent = "Choose one to complete. The unchosen task will return to the pool.";
    saveState();
    render();
  }

  function completeTask(taskIndex) {
    const task = state.choices[taskIndex];
    if (task === undefined) return;
    state.completed.push(task);
    state.choices.splice(taskIndex, 1);
    state.pool.push(...state.choices);
    state.choices = [];
    drawStatus.textContent = "Task completed: " + task;
    saveState();
    render();
  }

  function returnBoth() {
    if (!state.choices.length) return;
    state.pool.push(...state.choices);
    state.choices = [];
    drawStatus.textContent = "Both tasks returned to the pool.";
    saveState();
    render();
  }

  function render() {
    poolStatus.textContent = `${state.pool.length} task${state.pool.length === 1 ? "" : "s"} available`;
    choicesEl.replaceChildren();
    if (!state.choices.length) {
      const message = document.createElement("p");
      message.className = "app-empty";
      message.textContent = state.pool.length >= 2 ? "Ready when you are. Draw two tasks." : "Add at least two available tasks, then draw.";
      choicesEl.appendChild(message);
    } else {
      state.choices.forEach((task, index) => {
        const card = document.createElement("div");
        card.className = "app-choice";
        const label = document.createElement("p");
        label.textContent = task;
        const button = document.createElement("button");
        button.className = "app-primary";
        button.textContent = "Complete this task";
        button.addEventListener("click", () => completeTask(index));
        card.append(label, button);
        choicesEl.appendChild(card);
      });
    }
    drawButton.disabled = state.choices.length > 0 || state.pool.length < 2;
    returnButton.disabled = state.choices.length === 0;
    completedStatus.textContent = `${state.completed.length} task${state.completed.length === 1 ? "" : "s"} completed`;
    completedList.replaceChildren();
    state.completed.forEach(task => {
      const item = document.createElement("li");
      item.textContent = task;
      completedList.appendChild(item);
    });
  }

  document.getElementById("addTasksButton").addEventListener("click", () => addTasks(false));
  document.getElementById("replaceTasksButton").addEventListener("click", () => addTasks(true));
  drawButton.addEventListener("click", drawTwo);
  returnButton.addEventListener("click", returnBoth);
  document.getElementById("clearCompletedButton").addEventListener("click", () => {
    if (!confirm("Clear the completed-task history? This won't change your available pool.")) return;
    state.completed = [];
    saveState();
    render();
  });

  loadState();
  render();
</script>
</body>
</html>
